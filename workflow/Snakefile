"""
Phage Analysis Pipeline

A Snakemake workflow for phage prediction, clustering, and characterization.
"""
import os
import glob
from snakemake.utils import min_version

# Ensure minimum Snakemake version
min_version("8.0")

configfile: "../config/config.yaml"

# Import rules
include: "rules/01_prediction.smk"
include: "rules/02_clustering.smk"
include: "rules/03_analysis.smk"
include: "rules/04_summaries.smk"

# Import needed for file existence checks
import os

# Helper function to check if a path is a placeholder
def is_placeholder_path(path):
    """Check if a path is likely a placeholder that should be ignored."""
    if not path:
        return True
    placeholder_indicators = ["/path/to/", "PLACEHOLDER", "YOUR_", "CHANGE_ME"]
    return any(indicator in str(path) for indicator in placeholder_indicators)

# Clean up placeholder paths in config
if is_placeholder_path(config.get("assembly_file")):
    config["assembly_file"] = ""
if is_placeholder_path(config.get("assembly_graph")):
    config["assembly_graph"] = ""

# Validate required inputs - must provide exactly one
# Skip validation if starting from intermediate files
start_from_check = config.get("start_from", "raw_contigs")
if start_from_check == "raw_contigs":
    if not config.get("assembly_file") and not config.get("assembly_graph"):
        raise ValueError("Either 'assembly_file' or 'assembly_graph' must be provided in the config when start_from='raw_contigs'.")

    if config.get("assembly_file") and config.get("assembly_graph"):
        raise ValueError("Please provide either 'assembly_file' OR 'assembly_graph', not both. Use 'assembly_file' for FASTA-only workflow or 'assembly_graph' for Reneo workflow.")

    # Validate assembly_file input
    if config.get("assembly_file"):
        # Check if assembly_file exists
        if not os.path.exists(config.get("assembly_file", "")):
            raise ValueError(f"The specified assembly_file '{config.get('assembly_file')}' does not exist.")

    # Validate assembly_graph input
    if config.get("assembly_graph"):
        # Check if assembly_graph file exists
        if not os.path.exists(config.get("assembly_graph", "")):
            raise ValueError(f"The specified assembly_graph file '{config.get('assembly_graph')}' does not exist.")

        # Ensure reads_dir is provided (required for Reneo)
        if not config.get("reads_dir"):
            raise ValueError("When using 'assembly_graph', 'reads_dir' must be provided for Reneo to work.")

# Make sure reads_dir is provided when needed
# Only required for raw_contigs start (for viral enrichment) or when using assembly_graph
if start_from_check in ["raw_contigs", "reneo"]:
    if not config.get("reads_dir"):
        raise ValueError("'reads_dir' must be provided in the config when starting from raw contigs or reneo.")

# Validate start_from configuration
start_from = config.get("start_from", "raw_contigs")
valid_start_points = ["raw_contigs", "reneo", "viral_contigs", "phage_contigs", "clustering"]

if start_from not in valid_start_points:
    raise ValueError(f"Invalid start_from value: '{start_from}'. Must be one of: {', '.join(valid_start_points)}")

# Validate alternative inputs when using non-default start points
if start_from != "raw_contigs":
    alt_inputs = config.get("alternative_inputs", {})

    if start_from == "reneo":
        reneo_dir = alt_inputs.get("reneo_output_dir", "")
        if not reneo_dir or is_placeholder_path(reneo_dir):
            raise ValueError("When start_from='reneo', you must provide 'alternative_inputs.reneo_output_dir' in config")
        if not os.path.exists(reneo_dir):
            raise ValueError(f"Reneo output directory does not exist: {reneo_dir}")

    elif start_from == "viral_contigs":
        viral_file = alt_inputs.get("viral_contigs_file", "")
        if not viral_file or is_placeholder_path(viral_file):
            raise ValueError("When start_from='viral_contigs', you must provide 'alternative_inputs.viral_contigs_file' in config")
        if not os.path.exists(viral_file):
            raise ValueError(f"Viral contigs file does not exist: {viral_file}")

    elif start_from == "phage_contigs":
        phage_file = alt_inputs.get("phage_contigs_file", "")
        if not phage_file or is_placeholder_path(phage_file):
            raise ValueError("When start_from='phage_contigs', you must provide 'alternative_inputs.phage_contigs_file' in config")
        if not os.path.exists(phage_file):
            raise ValueError(f"Phage contigs file does not exist: {phage_file}")

    elif start_from == "clustering":
        clustered_file = alt_inputs.get("clustered_seqs_file", "")
        if not clustered_file or is_placeholder_path(clustered_file):
            raise ValueError("When start_from='clustering', you must provide 'alternative_inputs.clustered_seqs_file' in config")
        if not os.path.exists(clustered_file):
            raise ValueError(f"Clustered sequences file does not exist: {clustered_file}")

print(f"Pipeline configured to start from: {start_from}")

# Will be set by 01_prediction.smk
use_reneo = False

# Default target rule
rule all:
    input:
        # Start with appropriate filtered assembly based on whether Reneo will run
        [f"{config['output_dir']}/01_reneo_output/genomes_and_unresolved_edges_1KB.fasta"] 
        if workflow.globals["use_reneo"] else 
        [f"{config['output_dir']}/01_filtered_assembly/filtered_assembly_1KB.fasta"],
            
        # Explicitly include splitting steps to ensure they appear in the plan
        f"{config['output_dir']}/03_split_seqs/split_file_list.txt",
        
        # Add checkpoint triggers
        f"{config['output_dir']}/03_iphop_results/.splits_ready",
        
        # Add the input file checkpoints
        f"{config['output_dir']}/03_iphop_results/.input_files_found",
        
        # Add helpers that run the single prediction jobs
        f"{config['output_dir']}/03_iphop_results/.all_predictions_done",
        
        # Final output files depending on whether clustering is enabled
        lambda wildcards: 
            expand(
                "{outdir}/03_iphop_results/iphop_predictions_compiled.tsv",
                outdir=config["output_dir"]
            ) +
            # Add BACPHLIP lifestyle prediction
            expand(
                "{outdir}/03_genomic_info/bacphlip_lifestyle.tsv",
                outdir=config["output_dir"]
            ) +
            expand(
                "{outdir}/03_genomic_info/bacphlip_lifestyle_with_completeness.tsv",
                outdir=config["output_dir"]
            ) +
            expand(
                "{outdir}/03_genomic_info/mmseqs_taxonomy.tsv",
                outdir=config["output_dir"]
            ) +
            # Add Phabox2 outputs (taxonomy and lifestyle prediction)
            expand(
                "{outdir}/03_genomic_info/phabox_output/taxonomy.tsv",
                outdir=config["output_dir"]
            ) +
            expand(
                "{outdir}/03_genomic_info/phabox_output/lifestyle.tsv", 
                outdir=config["output_dir"]
            ) +
            # Add vContact3 output (gene-content based taxonomy)
            expand(
                "{outdir}/03_genomic_info/vc3_output",
                outdir=config["output_dir"]
            ) +
            # Add taxonomic consensus (if enabled)
            (["{outdir}/03_genomic_info/consensus_taxonomy.tsv".format(
                outdir=config["output_dir"]
             )] if config.get("run_consensus", True) else []) +
            (["{outdir}/02_clustering/vOTU_repSeqs.fasta".format(
                outdir=config["output_dir"]
             )] if config.get("do_clustering", True) else []) +
            # Add summary collection and report generation if enabled (default: True)
            (["{outdir}/pipeline_summaries/.all_summaries_collected".format(
                outdir=config["output_dir"]
             ), "{outdir}/Pipeline_Summary_Report.html".format(
                outdir=config["output_dir"]
             )] if config.get("generate_summaries", True) else [])
