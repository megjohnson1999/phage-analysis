if MODULES.get("abundance"):
    include: "rules/05_abundance.smk"

# Helper function to check if a path is a placeholder
def is_placeholder_path(path):
    """Check if a path is likely a placeholder that should be ignored."""
    if not path:
        return True
    placeholder_indicators = ["/path/to/", "PLACEHOLDER", "YOUR_", "CHANGE_ME"]
    return any(indicator in str(path) for indicator in placeholder_indicators)

# Clean up placeholder paths in config
if is_placeholder_path(config.get("assembly_file")):
    config["assembly_file"] = ""
if is_placeholder_path(config.get("assembly_graph")):
    config["assembly_graph"] = ""

# Validate required inputs - must provide exactly one
if not config.get("assembly_file") and not config.get("assembly_graph"):
    raise ValueError("Either 'assembly_file' or 'assembly_graph' must be provided in the config.")

if config.get("assembly_file") and config.get("assembly_graph"):
    raise ValueError("Please provide either 'assembly_file' OR 'assembly_graph', not both. Use 'assembly_file' for FASTA-only workflow or 'assembly_graph' for Reneo workflow.")

# Validate assembly_file input
if config.get("assembly_file"):
    # Check if assembly_file exists
    if not os.path.exists(config.get("assembly_file", "")):
        raise ValueError(f"The specified assembly_file '{config.get('assembly_file')}' does not exist.")

# Validate assembly_graph input  
if config.get("assembly_graph"):
    # Check if assembly_graph file exists
    if not os.path.exists(config.get("assembly_graph", "")):
        raise ValueError(f"The specified assembly_graph file '{config.get('assembly_graph')}' does not exist.")
    
    # Ensure reads_dir is provided (required for Reneo)
    if not config.get("reads_dir"):
        raise ValueError("When using 'assembly_graph', 'reads_dir' must be provided for Reneo to work.")

# Make sure reads_dir is provided in all cases
if not config.get("reads_dir"):
    raise ValueError("'reads_dir' must be provided in the config.")

# Validate entry point configuration
start_from = config.get("start_from", "assembly")
valid_entry_points = ["assembly", "clustered_sequences"]

if start_from not in valid_entry_points:
    raise ValueError(f"Invalid start_from value '{start_from}'. Must be one of: {valid_entry_points}")

# Validate entry point inputs
if start_from == "clustered_sequences":
    if not config.get("clustered_sequences_file"):
        raise ValueError("When start_from='clustered_sequences', you must provide 'clustered_sequences_file' in the config.")

    if is_placeholder_path(config.get("clustered_sequences_file")):
        raise ValueError("Please provide a valid path for 'clustered_sequences_file' (not a placeholder).")

    if not os.path.exists(config.get("clustered_sequences_file")):
        raise ValueError(f"The specified clustered_sequences_file '{config.get('clustered_sequences_file')}' does not exist.")

    # Create symlink to place user file at expected location (02_clustering/vOTU_repSeqs.fasta)
    # This allows downstream rules to work without modification
    os.makedirs(f"{config['output_dir']}/02_clustering", exist_ok=True)
    expected_location = f"{config['output_dir']}/02_clustering/vOTU_repSeqs.fasta"

    # Only create symlink if it doesn't already exist or points to wrong target
    if os.path.exists(expected_location) or os.path.islink(expected_location):
        # Check if it's already the correct symlink
        if os.path.islink(expected_location):
            current_target = os.readlink(expected_location)
            if os.path.abspath(current_target) != os.path.abspath(config.get("clustered_sequences_file")):
                # Remove old symlink and create new one
                os.remove(expected_location)
                os.symlink(os.path.abspath(config.get("clustered_sequences_file")), expected_location)
        elif os.path.isfile(expected_location):
            # Regular file exists - don't overwrite, but warn user
            print(f"Warning: File already exists at {expected_location}. Using existing file instead of creating symlink.")
    else:
        # Create new symlink
        os.symlink(os.path.abspath(config.get("clustered_sequences_file")), expected_location)
        print(f"Created symlink: {expected_location} -> {config.get('clustered_sequences_file')}")

# Will be set by 01_prediction.smk
use_reneo = False

