"""
Phage Analysis Pipeline

A Snakemake workflow for phage prediction, clustering, and characterization.
"""
import os
import glob
from snakemake.utils import min_version

# Ensure minimum Snakemake version
min_version("8.0")

configfile: "../config/config.yaml"

# Import rules
include: "rules/01_prediction.smk"
include: "rules/02_clustering.smk"
include: "rules/03_analysis.smk"
include: "rules/03_analysis_phacts_fix.smk"  # Ensure PHACTS fixes are loaded

# Import needed for file existence checks
import os

# Validate required inputs
if not config.get("assembly_file") and not config.get("assembly_graph"):
    raise ValueError("At least one of 'assembly_file' or 'assembly_graph' must be provided in the config.")

# Handle case where only assembly_file is provided (no assembly_graph)
if (not config.get("assembly_graph") or config.get("assembly_graph") == "") and config.get("assembly_file"):
    # Check if assembly_file exists
    if not os.path.exists(config.get("assembly_file", "")):
        raise ValueError(f"The specified assembly_file '{config.get('assembly_file')}' does not exist.")

# Handle case where only assembly_graph is provided (no assembly_file)
if (not config.get("assembly_file") or config.get("assembly_file") == "") and config.get("assembly_graph") and config.get("assembly_graph") != "":
    # Ensure assembly_graph value is valid
    if not os.path.exists(config.get("assembly_graph", "")):
        raise ValueError(f"The specified assembly_graph file '{config.get('assembly_graph')}' does not exist.")
    
    # Ensure reads_dir is provided (required for Reneo)
    if not config.get("reads_dir"):
        raise ValueError("When using only 'assembly_graph' (without assembly_file), 'reads_dir' must also be provided for Reneo to work.")

# If assembly_graph is provided (regardless of assembly_file), validate it
if config.get("assembly_graph") and config.get("assembly_graph") != "":
    if not config.get("reads_dir"):
        raise ValueError("When using 'assembly_graph', 'reads_dir' must also be provided for Reneo to work.")
    
    # Check if the assembly_graph file exists
    if not os.path.exists(config.get("assembly_graph", "")):
        raise ValueError(f"The specified assembly_graph file '{config.get('assembly_graph')}' does not exist.")

# Make sure reads_dir is provided in all cases
if not config.get("reads_dir"):
    raise ValueError("'reads_dir' must be provided in the config.")

# Will be set by 01_prediction.smk
use_reneo = False

# Override get_phacts_samples function to use in both modules without conflicts
def get_phacts_samples_compatibility():
    # After split_protein_files is run, this reads the split file list
    split_list = f"{config['output_dir']}/03_split_proteins/split_protein_list.txt"
    
    # Primary method: read from the split file list if it exists
    if os.path.exists(split_list):
        try:
            with open(split_list, "r") as f:
                files = [line.strip() for line in f if line.strip()]
            # Extract filenames without extension and ensure unique values
            samples = [os.path.splitext(os.path.basename(file))[0] for file in files]
            # Filter out any empty strings
            samples = [s for s in samples if s]
            # If we found samples, return them
            if samples:
                return samples
        except Exception as e:
            print(f"Warning: Error reading split file list: {e}")
    
    # Fallback: Use glob to find faa files directly
    try:
        split_dir = f"{config['output_dir']}/03_split_proteins"
        if os.path.exists(split_dir) and os.path.isdir(split_dir):
            samples = [os.path.splitext(os.path.basename(f))[0] 
                    for f in glob.glob(f"{split_dir}/*.faa")]
            # Filter out any empty strings
            samples = [s for s in samples if s]
            if samples:
                return samples
    except Exception as e:
        print(f"Warning: Error using glob to find faa files: {e}")
    
    # If all methods fail, return empty list
    return []

# Default target rule
