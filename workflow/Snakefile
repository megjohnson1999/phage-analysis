"""
Phage Analysis Pipeline

A Snakemake workflow for phage prediction, clustering, and characterization.
"""
import os
import glob
from snakemake.utils import min_version

# Ensure minimum Snakemake version
min_version("8.0")

configfile: "../config/config.yaml"

# Import needed for file existence checks
import os

# ================================================================================
# Module Configuration System
# ================================================================================

def get_modules():
    """
    Determine which pipeline modules to run based on configuration.

    Supports two modes:
    1. analysis_type presets: Simple predefined workflows
    2. Granular module control: Fine-grained control over individual modules

    Returns dictionary with module names as keys and boolean values
    """
    # Check for old-style config flags and show deprecation warning
    old_flags = {
        "do_clustering": config.get("do_clustering"),
        "generate_summaries": config.get("generate_summaries"),
        "calculate_abundance": config.get("calculate_abundance")
    }

    # If old flags are explicitly set (not None), use them but warn
    if any(v is not None for v in old_flags.values()):
        print("\n" + "="*80)
        print("WARNING: Using deprecated config flags")
        print("="*80)
        print("The following flags are deprecated and will be removed in a future version:")
        print("  - do_clustering")
        print("  - generate_summaries")
        print("  - calculate_abundance")
        print("\nPlease migrate to the new 'analysis_type' or 'modules' config system.")
        print("See config/config.yaml for examples.")
        print("="*80 + "\n")

        # Map old flags to new module system
        return {
            "prediction": True,  # Always required
            "clustering": old_flags.get("do_clustering", True),
            "analysis": True,  # Always required when prediction runs
            "summaries": old_flags.get("generate_summaries", True),
            "abundance": old_flags.get("calculate_abundance", False)
        }

    # Check for analysis_type preset
    analysis_type = config.get("analysis_type")
    if analysis_type:
        presets = {
            "prediction_only": {
                "prediction": True,
                "clustering": False,
                "analysis": False,
                "summaries": False,
                "abundance": False
            },
            "standard": {
                "prediction": True,
                "clustering": True,
                "analysis": True,
                "summaries": True,
                "abundance": False
            },
            "comprehensive": {
                "prediction": True,
                "clustering": True,
                "analysis": True,
                "summaries": True,
                "abundance": True
            }
        }

        if analysis_type not in presets:
            raise ValueError(
                f"Invalid analysis_type: '{analysis_type}'. "
                f"Must be one of: {list(presets.keys())}"
            )

        return presets[analysis_type]

    # Use granular module configuration
    modules_config = config.get("modules", {})

    # Default: standard analysis (everything except abundance)
    return {
        "prediction": True,  # Always required
        "clustering": modules_config.get("clustering", True),
        "analysis": modules_config.get("analysis", True),
        "summaries": modules_config.get("summaries", True),
        "abundance": modules_config.get("abundance", False)
    }

MODULES = get_modules()

# Validate module dependencies
def validate_modules():
    """Validate that required module dependencies are met"""
    errors = []

    # Abundance requires clustering (needs vOTUs for abundance calculation)
    if MODULES.get("abundance") and not MODULES.get("clustering"):
        errors.append(
            "Module dependency error: 'abundance' module requires 'clustering' module.\n"
            "  Either enable clustering or disable abundance calculation."
        )

    # Analysis requires prediction (needs predicted sequences)
    if MODULES.get("analysis") and not MODULES.get("prediction"):
        errors.append(
            "Module dependency error: 'analysis' module requires 'prediction' module.\n"
            "  Cannot run analysis without prediction."
        )

    # Summaries should have something to summarize
    if MODULES.get("summaries") and not MODULES.get("analysis"):
        print("\nWARNING: 'summaries' module enabled but 'analysis' is disabled.")
        print("  Summary reports will have limited information without analysis results.\n")

    if errors:
        raise ValueError("\n" + "\n".join(errors))

    # Print module status
    print("\n" + "="*80)
    print("Pipeline Modules Configuration")
    print("="*80)
    for module, enabled in MODULES.items():
        status = "ENABLED" if enabled else "DISABLED"
        print(f"  {module:15s}: {status}")
    print("="*80 + "\n")

validate_modules()

# ================================================================================
# Conditional Module Imports
